[Unit]
Description=DSH NapCat WS forwarder (127.0.0.1:3001 -> container napcat:3001)
After=docker.service network.target
Wants=docker.service

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/dsh-suite/qq-bridge
ExecStart=/home/agent/dsh-suite/.venv/bin/python /home/agent/dsh-suite/qq-bridge/ws-forward.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
