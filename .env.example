# BellHub 环境变量示例
# 用法：cp .env.example .env 然后按需改；systemd 用户请把需要的项写进单元的 EnvironmentFile=
# 注意：环境变量里的 ~ 不会展开，路径必须写绝对路径。

# ── 站点 ────────────────────────────────────────────────────
# 站娘显示名：会出现在对话参与者与任务 assignee 匹配里
SUITE_AGENT_NAME=助手

# 运行态根目录（库、密钥、产物）
DSH_SUITE_DATA=/home/agent/dsh-suite/data
# 用户沙箱与网盘根
DSH_DRIVE_ROOT=/home/agent/dsh-users
# 对外发给用户的连接器目录
BELLHUB_WORKERS_DIR=/home/agent/dsh-suite/workers

# ── MCP 鉴权 ────────────────────────────────────────────────
# token 文件（600，首次启动自动生成）；也可直接用 BELLHUB_MCP_TOKEN 注入
MCP_TOKEN_FILE=/home/agent/dsh-suite/data/mcp_token
# MCP 会话空闲回收（秒），默认 30 天
BELLHUB_MCP_IDLE_TIMEOUT=2592000

# ── 对话 / 值班应答面 ───────────────────────────────────────
NEKO_CHAT_BASE_URL=https://api.deepseek.com
NEKO_CHAT_MODEL=deepseek-chat
NEKO_CHAT_MAX_INPUT=4000
NEKO_CHAT_HISTORY=10
NEKO_CHAT_DAILY_TOKENS=200000
PUBLIC_CHAT_DAILY_TOKENS=20000
NEKO_CHAT_TIMEOUT=90
# 值守会话传给 dsh headless 的模型凭据（也可以只填在面板「助手对话」设置里）
DEEPSEEK_API_KEY=

# ── 成本闸（2026-11-13）────────────────────────────────────
# 今日花费 ≥ 此值（人民币）时，面板对话与站娘任务直接拒绝，不启动 headless；0 = 关闭
SUITE_COST_DAILY_CAP_CNY=12
# DSH 用量账本（面板读它做成本看板与告警；默认 ~/.dsh-admin/.dshw-usage.json）
# DSH_USAGE_FILE=/home/agent/.dsh-admin/.dshw-usage.json

# ── 值守 / 伙伴分身（配置文件里也有一份，二者取其一）──────────
# DSH_RESIDENT_CONFIG=/home/agent/dsh-suite/workers/resident.config.json
# DSH_PARTNER_CONFIG=/home/agent/dsh-suite/workers/partner.config.json
# BELLHUB_HUB_URL=http://127.0.0.1:8765

# ── QQ 桥（可选）────────────────────────────────────────────
# QQ_BRIDGE_HOST=127.0.0.1
# QQ_BRIDGE_PORT=8770
# QQ_ALLOW=                 # 白名单 QQ 号，逗号分隔；空 = 谁都不许
# ONEBOT_API=http://127.0.0.1:3000
# ONEBOT_TOKEN=
# QQ_BRIDGE_TOKEN=

# ── 知识库（可选，kb/kb_config.json 为准）────────────────────
# KB_HOST=127.0.0.1
# KB_PORT=8787
# KB_TOKEN=
